# Keep large bulk renders, uncompressed archives, and local scratch exports out of Git.
# Compact 16kHz mono validation samples in data/demo_audio/*.wav (~8.4 MB total)
# are tracked for deterministic CI/CD and schema-to-audio verification.
data/bulk_audio/
data/high_res_audio/
data/raw_renders/
data/exports_large/
*.flac
*.zip
*.tar.gz
*.tgz
.pytest_cache/
__pycache__/
*.pyc
.env
*.token
*.key

# Hugging Face export (huggingface/) — rebuilt by `python3 -m src.export_huggingface build`.
# README.md, LICENSE.md and data/*/metadata.jsonl are tracked for review. The WAV copies
# (already tracked once in data/demo_audio/), the supplementary duplicates, and the generated
# manifest/LFS attributes are not.
huggingface/data/**/*.wav
huggingface/supplementary/
huggingface/MANIFEST.sha256
huggingface/.gitattributes
# Local third-party metadata imports are never part of the Hub export.
data/third_party/
